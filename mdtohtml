    caution: '<svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M4.47.22A.749.749 0 0 1 5 0h6c.199 0 .389.079.53.22l4.25 4.25c.141.14.22.331.22.53v6a.749.749 0 0 1-.22.53l-4.25 4.25A.749.749 0 0 1 11 16H5a.749.749 0 0 1-.53-.22L.22 11.53A.749.749 0 0 1 0 11V5c0-.199.079-.389.22-.53Zm.84 1.28L1.5 5.31v5.38l3.81 3.81h5.38l3.81-3.81V5.31L10.69 1.5ZM8 4a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 8 4m0 8a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/></svg>'
  };
  var labels = {note:"Note",tip:"Tip",important:"Important",warning:"Warning",caution:"Caution"};
  document.querySelectorAll("blockquote").forEach(function(bq) {
    var p = bq.querySelector("p");
    if (!p) return;
    var m = p.textContent.match(/^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\n?/);
    if (!m) return;
    var type = m[1].toLowerCase();
    // Replace blockquote with div to avoid blockquote CSS interference
    var div = document.createElement("div");
    div.className = "markdown-alert markdown-alert-" + type;
    var title = document.createElement("p");
    title.className = "markdown-alert-title";
    title.innerHTML = icons[type] + labels[type];
    div.appendChild(title);
    p.textContent = p.textContent.replace(m[0], "");
    if (p.textContent.trim()) { div.appendChild(p); }
    // Move remaining children from blockquote to div
    while (bq.firstChild) { div.appendChild(bq.firstChild); }
    bq.parentElement.replaceChild(div, bq);
  });
})();
</script>
