#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"

usage() {
  cat <<'EOF'
Usage: mdtohtml <file.md> [file2.md ...]

Convert markdown files to GitHub-style HTML files.
Each input file produces a .html file in the same directory.
Uses cmark-gfm for local rendering — no internet required for conversion.
CSS and syntax highlighting loaded from CDN when available.
Install dependency: brew install cmark-gfm
EOF
  exit 1
}

if [[ $# -eq 0 ]]; then usage; fi

# Only check first arg for flags — files named --help won't conflict
case "${1:-}" in
  --help|-h) usage ;;
  --version|-v) echo "mdtohtml $VERSION"; exit 0 ;;
esac

if ! command -v cmark-gfm &>/dev/null; then
  echo "Error: cmark-gfm is required (brew install cmark-gfm)" >&2
  exit 1
fi

converted=0

for file in "$@"; do
  if [[ ! -f "$file" || ! -r "$file" ]]; then
    echo "Warning: cannot read '$file', skipping" >&2
    continue
  fi

  # Render markdown to HTML locally with all GFM extensions
  body=$(cmark-gfm -e table -e autolink -e tagfilter -e strikethrough -e tasklist -e footnotes --unsafe < "$file")

  # Output file: replace .md extension with .html (or append .html)
  outfile="${file%.md}.html"

  # Escape &, <, > for safe use in <title> tag
  filename=$(basename "$file")
  safe_title="${filename//&/&amp;}"
  safe_title="${safe_title//</&lt;}"
  safe_title="${safe_title//>/&gt;}"

  # Conditional CDN scripts — only load when content needs them
  scripts=""
  if [[ "$body" == *'language-mermaid'* ]]; then
    read -r -d '' mermaid_script <<'MERMAIDEOF' || true
<script>
document.querySelectorAll("code.language-mermaid").forEach(function(code) {
  var pre = code.parentElement;
  var div = document.createElement("div");
  div.className = "mermaid";
  div.textContent = code.textContent;
  pre.parentElement.replaceChild(div, pre);
});
</script>
<script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
<script>mermaid.initialize({startOnLoad: true, theme: "dark"});</script>
MERMAIDEOF
    scripts+="$mermaid_script"
  fi

  if grep -qE '\$\$|\$[^ $`]|\\\\?\(' "$file" 2>/dev/null; then
    read -r -d '' math_script <<'MATHEOF' || true
<script>
MathJax = {
  tex: {
    inlineMath: [["$","$"],["\\(","\\)"]],
    displayMath: [["$$","$$"],["\\[","\\]"]]
  },
  options: {skipHtmlTags: ["script","noscript","style","textarea","pre","code"]}
};
</script>
<script id="MathJax-script" src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
MATHEOF
    scripts+="$math_script"
  fi

  # Assemble HTML — quoted heredocs + printf to avoid shell expansion
  {
    cat <<'HEADER'
<!DOCTYPE html>
<html lang="en" data-color-mode="dark" data-dark-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
HEADER
    printf '<title>%s</title>\n' "$safe_title"
    cat <<'STYLES'
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/github-markdown-css@5/github-markdown-dark.min.css">
<style>
body { background: #0d1117; margin: 0; padding: 0; }
.markdown-body { max-width: 980px; margin: 0 auto; padding: 32px 28px; }
/* GitHub dark syntax highlighting — "pretty-lights" token classes */
.pl-c { color: #8b949e; }
.pl-c1, .pl-s .pl-v { color: #79c0ff; }
.pl-e, .pl-en { color: #d2a8ff; }
.pl-smi, .pl-s .pl-s1 { color: #c9d1d9; }
