kbd {
  background: #161b22; border: 1px solid #30363d; border-bottom-color: #21262d;
  border-radius: 6px; box-shadow: inset 0 -1px 0 #21262d;
  color: #e6edf3; font-size: 11px; line-height: 10px; padding: 3px 5px;
  vertical-align: middle;
}
/* GitHub-style alerts — matches github.com markup: div.markdown-alert */
.markdown-alert {
  border-left: 3px solid; padding: 8px 16px;
  margin-bottom: 16px; color: inherit;
}
.markdown-alert > :first-child { margin-top: 0; }
.markdown-alert > :last-child { margin-bottom: 0; }
.markdown-alert-title {
  display: flex; align-items: center; gap: 8px;
  font-weight: 600; margin-bottom: 4px; line-height: 1;
}
.markdown-alert-title svg { flex-shrink: 0; }
.markdown-alert-note { border-color: #1f6feb; }
.markdown-alert-note .markdown-alert-title { color: #4493f8; }
.markdown-alert-tip { border-color: #238636; }
.markdown-alert-tip .markdown-alert-title { color: #3fb950; }
.markdown-alert-important { border-color: #8957e5; }
.markdown-alert-important .markdown-alert-title { color: #ab7df8; }
