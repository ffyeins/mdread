#!/usr/bin/env bash
set -euo pipefail

VERSION="2.0.0"
prog=mdtohtml

usage() {
  cat <<'EOF'
Usage: mdtohtml [--light|--dark] [--force] [--] <file.md> [file2.md ...]

Convert markdown files to GitHub-style HTML files.
Each input file produces a .html file in the same directory (README.md -> README.html).
Markdown is rendered locally with comrak; styling, syntax highlighting, math and
diagrams load from CDNs when the page is viewed.

Options:
  --light        Render with the GitHub light theme
  --dark         Render with the GitHub dark theme (default)
  -f, --force    Overwrite existing .html files that mdtohtml didn't generate
  -h, --help     Show this help
  -v, --version  Show the version
  --             Treat every following argument as a file

Install the dependency with: brew install comrak
EOF
}

here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")
# shellcheck source=lib/render.sh
source "$here/lib/render.sh" || { echo "$prog: cannot load $here/lib/render.sh" >&2; exit 1; }

mdr_parse_args 1 "$@"
case $action in
  help) usage; exit 0 ;;
  version) echo "$prog $VERSION"; exit 0 ;;
esac
[[ ${#files[@]} -gt 0 ]] || { usage >&2; exit 2; }
mdr_require_deps

# Output files get the permissions a plain redirect would give them
mode=$(printf '%o' $((0666 & ~$(umask))))

# Partial output is removed if we're interrupted mid-file
tmp=""
trap 'if [[ -n $tmp ]]; then rm -f -- "$tmp"; fi' EXIT

shopt -s nocasematch
failed=0
for file in "${files[@]}"; do
  # Keep dash-leading names from being read as options further down
  [[ $file == -* ]] && file="./$file"

  if [[ ! -f $file || ! -r $file ]]; then
    echo "$prog: cannot read '$file', skipping" >&2
    failed=1
    continue
  fi

  case $file in
    *.md|*.markdown|*.mdown|*.mkd|*.mkdn) outfile="${file%.*}.html" ;;
    *) outfile="$file.html" ;;
  esac

  # Never clobber an HTML file this tool didn't write. mdtohtml 1.x output has no generator
  # tag but links the major-pinned stylesheet.
  if [[ -e $outfile && $force -eq 0 ]] &&
    ! grep -qE '<meta name="generator" content="mdtohtml |github-markdown-css@5/github-markdown-(dark|light)\.min\.css' "$outfile"; then
    echo "$prog: '$outfile' exists and wasn't generated by mdtohtml; use --force to overwrite" >&2
    failed=1
    continue
  fi

  # Render beside the output, then move into place so a failure never leaves a broken file
  if ! tmp=$(mktemp "$outfile.XXXXXX" 2>/dev/null); then
    echo "$prog: cannot write next to '$file'" >&2
    failed=1
    continue
  fi
  if mdr_render_html "$file" "$theme" > "$tmp"; then
    chmod "$mode" "$tmp"
    mv -f "$tmp" "$outfile"
    printf '%s\n' "$outfile"
  else
    echo "$prog: failed to render '$file'" >&2
    rm -f "$tmp"
    failed=1
  fi
done

exit "$failed"
