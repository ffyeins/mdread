# Pele draws every diagram in the mermaid.md gallery, pie included, in GitHub's dark colors,
# each with the diagram buttons
@ source ../../mermaid.md
@ mermaid pele
=26 class="pele-diagram"
=26 class="mdr-diagram"
=26 aria-label="Copy diagram source"
=26 aria-label="Download SVG"
=26 aria-label="Expand diagram"
+ class="pele pele-pie"
+ --pele-bg: #151b23
- class="mdr-diagram-error"
- data-processed
- beautiful-mermaid@
