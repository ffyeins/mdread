# Default renderer on the mermaid.md gallery: beautiful-mermaid draws the types it supports
# (flowchart, sequence, class, state, ER, XY chart), Pele draws the other 16; each gets the
# diagram buttons; mermaid.js and Google Fonts never load
@ source ../../mermaid.md
=10 class="beautiful-mermaid"
=16 class="pele-diagram"
=26 class="mdr-diagram"
=26 aria-label="Copy diagram source"
=26 aria-label="Download SVG"
=26 aria-label="Expand diagram"
+ class="pele pele-pie"
+ --bg: #151b23
- class="mdr-diagram-error"
- data-processed
- fonts.googleapis.com
- mermaid.min.js
=1 <script src="https://cdn.jsdelivr.net/npm/pele
