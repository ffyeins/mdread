#!/usr/bin/env bash
set -euo pipefail

VERSION="3.0.0"

usage() {
  cat <<'EOF'
Usage: mdread <file.md> [file2.md ...]

Convert markdown files to GitHub-rendered HTML and open in the browser.
Uses GitHub's Markdown API for pixel-perfect rendering — requires internet.
Set GITHUB_TOKEN or GH_TOKEN for higher API rate limits (5000/hr vs 60/hr).
EOF
  exit 1
}

if [[ $# -eq 0 ]]; then usage; fi

# Only check first arg for flags — files named --help won't conflict
case "${1:-}" in
  --help|-h) usage ;;
  --version|-v) echo "mdread $VERSION"; exit 0 ;;
esac

if ! command -v curl &>/dev/null; then
  echo "Error: curl is required" >&2
  exit 1
fi

# Resolve GitHub API auth token
token="${GITHUB_TOKEN:-${GH_TOKEN:-}}"

# Track temp files for cleanup; trap ensures they're removed on early exit or error
tmpfiles=()
converted=0
cleanup() { rm -f "${tmpfiles[@]}"; }
trap cleanup EXIT

for file in "$@"; do
  if [[ ! -f "$file" || ! -r "$file" ]]; then
    echo "Warning: cannot read '$file', skipping" >&2
    continue
  fi

  # Build JSON payload — use jq if available, otherwise python3
  if command -v jq &>/dev/null; then
    payload=$(jq -Rs '{"text": ., "mode": "gfm"}' < "$file")
  else
    payload=$(python3 -c "import json,sys; print(json.dumps({'text':sys.stdin.read(),'mode':'gfm'}))" < "$file")
  fi

  # Call GitHub Markdown API
  curl_args=(-s -X POST "https://api.github.com/markdown"
    -H "Content-Type: application/json"
    -H "Accept: application/vnd.github+json"
    -H "X-GitHub-Api-Version: 2022-11-28")
  [[ -n "$token" ]] && curl_args+=(-H "Authorization: Bearer $token")

  body=$(curl "${curl_args[@]}" -d "$payload")

  # Check for API errors (error responses contain "message" + "documentation_url")
  if [[ "$body" == *'"message"'* && "$body" == *'"documentation_url"'* ]]; then
    echo "Warning: GitHub API error for '$file'" >&2
    if command -v jq &>/dev/null; then
      echo "  $(echo "$body" | jq -r '.message')" >&2
    else
      echo "  $body" >&2
    fi
    echo "  Hint: Set GITHUB_TOKEN for higher rate limits (5000/hr)" >&2
    continue
  fi

  # macOS mktemp only replaces trailing Xs, so we create then rename to add .html
  tmp=$(mktemp /tmp/mdread.XXXXXX)
  tmphtml="${tmp}.html"
  mv "$tmp" "$tmphtml"

  # Escape &, <, > for safe use in <title> tag
  filename=$(basename "$file")
  safe_title="${filename//&/&amp;}"
  safe_title="${safe_title//</&lt;}"
  safe_title="${safe_title//>/&gt;}"

  # Conditional CDN scripts — only load when content needs them
  scripts=""
  if [[ "$body" == *'highlight-source-mermaid'* ]]; then
    read -r -d '' mermaid_script <<'MERMAIDEOF' || true
<script>
document.querySelectorAll(".highlight-source-mermaid").forEach(function(container) {
  var pre = container.querySelector("pre");
  if (!pre) return;
  var div = document.createElement("div");
  div.className = "mermaid";
  div.textContent = pre.textContent;
  container.parentElement.replaceChild(div, container);
});
</script>
<script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
<script>mermaid.initialize({startOnLoad: true, theme: "dark"});</script>
MERMAIDEOF
    scripts+="$mermaid_script"
  fi

  if grep -qE '\$\$|\$[^ $`]|\\\\?\(' "$file" 2>/dev/null; then
    read -r -d '' math_script <<'MATHEOF' || true
<script>
MathJax = {
  tex: {
    inlineMath: [["$","$"],["\\(","\\)"]],
    displayMath: [["$$","$$"],["\\[","\\]"]]
  },
  options: {skipHtmlTags: ["script","noscript","style","textarea","pre","code"]}
};
</script>
<script id="MathJax-script" src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
MATHEOF
    scripts+="$math_script"
  fi

  # Assemble HTML — quoted heredocs + printf to avoid shell expansion of API output
  {
    cat <<'HEADER'
<!DOCTYPE html>
<html lang="en" data-color-mode="dark" data-dark-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
HEADER
    printf '<title>%s</title>\n' "$safe_title"
    cat <<'STYLES'
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/github-markdown-css@5/github-markdown-dark.min.css">
<style>
body { background: #0d1117; margin: 0; padding: 0; }
.markdown-body { max-width: 980px; margin: 0 auto; padding: 32px 28px; }
/* GitHub dark syntax highlighting — "pretty-lights" token classes */
.pl-c { color: #8b949e; }
.pl-c1, .pl-s .pl-v { color: #79c0ff; }
.pl-e, .pl-en { color: #d2a8ff; }
.pl-smi, .pl-s .pl-s1 { color: #c9d1d9; }
.pl-ent { color: #7ee787; }
.pl-k { color: #ff7b72; }
.pl-s, .pl-pds, .pl-s .pl-pse .pl-s1 { color: #a5d6ff; }
.pl-sr, .pl-sr .pl-cce, .pl-sr .pl-sre, .pl-sr .pl-sra { color: #a5d6ff; }
.pl-v, .pl-smw { color: #ffa657; }
.pl-bu { color: #f85149; }
.pl-ii { color: #f0f6fc; background-color: #8e1519; }
.pl-c2 { color: #f0f6fc; background-color: #b62324; }
.pl-ml { color: #f2cc60; }
.pl-mh, .pl-mh .pl-en, .pl-ms { color: #1f6feb; font-weight: bold; }
.pl-mi { color: #c9d1d9; font-style: italic; }
.pl-mb { color: #c9d1d9; font-weight: bold; }
.pl-md { color: #ffa198; background-color: #490202; }
.pl-mi1 { color: #56d364; background-color: #0f5323; }
.pl-mc { color: #ffa657; background-color: #5a1e02; }
.pl-mdr { color: #d2a8ff; }
/* Copy button */
.highlight, pre { position: relative; }
.copy-btn {
  position: absolute; top: 8px; right: 8px;
  background: #21262d; border: 1px solid #30363d; border-radius: 6px;
  color: #8b949e; cursor: pointer; padding: 4px; line-height: 1;
  opacity: 0; transition: opacity 0.15s;
}
.highlight:hover .copy-btn, pre:hover > .copy-btn { opacity: 1; }
.copy-btn:hover { color: #e6edf3; background: #30363d; }
</style>
</head>
<body>
<div class="markdown-body">
STYLES
    printf '%s\n' "$body"
    cat <<'SCRIPTS'
</div>
<script>
document.querySelectorAll("pre").forEach(function(pre) {
  if (pre.closest(".mermaid")) return;
  var container = pre.closest(".highlight") || pre;
  if (container.querySelector(".copy-btn")) return;
  var svgCopy = '<svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25zM5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25z"/></svg>';
  var svgCheck = '<svg viewBox="0 0 16 16" width="16" height="16" fill="#3fb950"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0z"/></svg>';
  var btn = document.createElement("button");
  btn.className = "copy-btn";
  btn.innerHTML = svgCopy;
  btn.title = "Copy";
  btn.addEventListener("click", function() {
    var code = pre.querySelector("code");
    var text = code ? code.textContent : pre.textContent;
    navigator.clipboard.writeText(text).then(function() {
      btn.innerHTML = svgCheck;
      setTimeout(function() { btn.innerHTML = svgCopy; }, 2000);
    });
  });
  container.appendChild(btn);
});
</script>
SCRIPTS
    printf '%s\n' "$scripts"
    printf '%s\n' "</body>" "</html>"
  } > "$tmphtml"

  tmpfiles+=("$tmphtml")
  ((++converted))
done

if [[ $converted -eq 0 ]]; then
  echo "Error: no files were converted" >&2
  exit 1
fi

# Open files one at a time to avoid flooding the browser with tabs
for f in "${tmpfiles[@]}"; do
  open "$f"
done

# Disarm the EXIT trap (files are now open), then schedule background cleanup.
# 10 seconds gives the browser time to read the files before they're deleted.
trap - EXIT
(sleep 10 && rm -f "${tmpfiles[@]}") & disown
