#!/usr/bin/env bash
set -euo pipefail

VERSION="2.1.0"

usage() {
  cat <<'EOF'
Usage: mdread <file.md> [file2.md ...]

Convert markdown files to GitHub dark-themed HTML and open in the browser.
EOF
  exit 1
}

if [[ $# -eq 0 ]]; then
  usage
fi

# Only check first arg for flags — files named --help won't conflict
case "${1:-}" in
  --help|-h) usage ;;
  --version|-v) echo "mdread $VERSION"; exit 0 ;;
esac

if ! command -v pandoc &>/dev/null; then
  echo "Error: pandoc is not installed. Install with: brew install pandoc" >&2
  exit 1
fi

# GitHub dark theme CSS — colors from github.com's dark mode
# || true because `read` returns 1 when it hits the delimiter instead of EOF
read -r -d '' CSS <<'CSSEOF' || true
body {
  background: #0d1117;
  color: #e6edf3;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif;
  font-size: 16px;
  line-height: 1.5;
  margin: 0;
  padding: 0;
}
.markdown-body {
  max-width: 900px;
  margin: 0 auto;
  padding: 32px 28px;
}
a {
  color: #58a6ff;
  text-decoration: none;
}
a:hover {
  text-decoration: underline;
}
h1, h2, h3, h4, h5, h6 {
  color: #e6edf3;
  margin-top: 24px;
  margin-bottom: 16px;
  font-weight: 600;
  line-height: 1.25;
}
h1 {
  font-size: 2em;
  padding-bottom: 0.3em;
  border-bottom: 1px solid #30363d;
}
h2 {
  font-size: 1.5em;
  padding-bottom: 0.3em;
  border-bottom: 1px solid #30363d;
}
h3 { font-size: 1.25em; }
h4 { font-size: 1em; }
p { margin-top: 0; margin-bottom: 16px; }
code {
  background: #161b22;
  padding: 0.2em 0.4em;
  border-radius: 6px;
  font-size: 85%;
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
}
pre {
  background: #161b22;
  padding: 16px;
  border-radius: 6px;
  overflow: auto;
  line-height: 1.45;
}
pre code {
  background: transparent;
  padding: 0;
  font-size: 85%;
}
blockquote {
  margin: 0 0 16px 0;
  padding: 0 1em;
  color: #8b949e;
  border-left: 0.25em solid #30363d;
}
hr {
  height: 0.25em;
  padding: 0;
  margin: 24px 0;
  background-color: #30363d;
  border: 0;
}
ul, ol {
  margin-top: 0;
  margin-bottom: 16px;
  padding-left: 2em;
}
li + li { margin-top: 0.25em; }
table {
  border-spacing: 0;
  border-collapse: collapse;
  margin-bottom: 16px;
  width: auto;
}
table th, table td {
  padding: 6px 13px;
  border: 1px solid #30363d;
}
table th {
  font-weight: 600;
  background: #161b22;
}
table tr:nth-child(2n) {
  background: #161b22;
}
img { max-width: 100%; }
input[type="checkbox"] {
  margin-right: 0.5em;
}
/* Syntax highlighting — pandoc breezedark token classes, colors matched to GitHub dark */
code span.al { color: #e5534b; font-weight: bold; }
code span.an { color: #8b949e; }
code span.at { color: #79c0ff; }
code span.bn { color: #79c0ff; }
code span.bu { color: #ffa657; }
code span.cf { color: #ff7b72; }
code span.ch { color: #a5d6ff; }
code span.cn { color: #79c0ff; }
code span.co { color: #8b949e; }
code span.cv { color: #8b949e; }
code span.do { color: #8b949e; }
code span.dt { color: #ff7b72; }
code span.dv { color: #79c0ff; }
code span.er { color: #e5534b; }
code span.ex { color: #d2a8ff; }
code span.fl { color: #79c0ff; }
code span.fu { color: #d2a8ff; }
code span.im { color: #ffa657; }
code span.in { color: #8b949e; }
code span.kw { color: #ff7b72; }
code span.op { color: #ff7b72; }
code span.ot { color: #79c0ff; }
code span.pp { color: #ff7b72; }
code span.re { color: #79c0ff; }
code span.sc { color: #a5d6ff; }
code span.ss { color: #a5d6ff; }
code span.st { color: #a5d6ff; }
code span.va { color: #ffa657; }
code span.vs { color: #a5d6ff; }
code span.wa { color: #e5534b; }
/* GitHub-style alerts: > [!NOTE], > [!TIP], > [!IMPORTANT], > [!WARNING], > [!CAUTION]
   Pandoc 3.9+ outputs these as <div class="note"> etc. */
.note, .tip, .important, .warning, .caution {
  padding: 8px 16px;
  margin-bottom: 16px;
  border-left: 0.25em solid;
  border-radius: 6px;
}
.note { border-color: #58a6ff; }
.tip { border-color: #3fb950; }
.important { border-color: #a371f7; }
.warning { border-color: #d29922; }
.caution { border-color: #f85149; }
.note > .title, .tip > .title, .important > .title, .warning > .title, .caution > .title {
  font-weight: 600;
  margin-bottom: 4px;
}
.note > .title p { color: #58a6ff; }
.tip > .title p { color: #3fb950; }
.important > .title p { color: #a371f7; }
.warning > .title p { color: #d29922; }
.caution > .title p { color: #f85149; }
section.footnotes {
  margin-top: 32px;
  padding-top: 16px;
  border-top: 1px solid #30363d;
  font-size: 0.875em;
  color: #8b949e;
}
section.footnotes ol { padding-left: 1.5em; }
a.footnote-ref { text-decoration: none; }
a.footnote-back { text-decoration: none; color: #58a6ff; margin-left: 4px; }
/* Pandoc wraps task lists in <ul class="task-list"> with checkboxes inside <label> */
ul.task-list {
  list-style: none;
  padding-left: 1.2em;
}
details {
  margin-bottom: 16px;
}
details summary {
  cursor: pointer;
  font-weight: 600;
  color: #e6edf3;
  padding: 8px 0;
}
details summary:hover {
  color: #58a6ff;
}
.math.display {
  overflow-x: auto;
  margin: 16px 0;
}
CSSEOF

# Track temp files for cleanup; trap ensures they're removed on early exit or error
tmpfiles=()
converted=0
cleanup() { rm -f "${tmpfiles[@]}"; }
trap cleanup EXIT

for file in "$@"; do
  if [[ ! -f "$file" || ! -r "$file" ]]; then
    echo "Warning: cannot read '$file', skipping" >&2
    continue
  fi

  # macOS mktemp only replaces trailing Xs, so we create then rename to add .html
  tmp=$(mktemp /tmp/mdread.XXXXXX)
  tmphtml="${tmp}.html"
  mv "$tmp" "$tmphtml"

  # --mathjax wraps math in \( \) delimiters for MathJax; -- prevents filename-as-flag
  if ! body=$(pandoc -f gfm -t html5 --mathjax --syntax-highlighting=breezedark -- "$file"); then
    echo "Warning: pandoc failed on '$file', skipping" >&2
    rm -f "$tmphtml"
    continue
  fi

  # Escape &, <, > for safe use in <title> tag
  filename=$(basename "$file")
  safe_title="${filename//&/&amp;}"
  safe_title="${safe_title//</&lt;}"
  safe_title="${safe_title//>/&gt;}"

  # Only load CDN scripts when the content actually needs them
  scripts=""
  if [[ "$body" == *'class="mermaid"'* ]]; then
    # Pandoc outputs <pre class="mermaid"><code>...</code></pre> but mermaid.js
    # expects raw text directly in the element — unwrap <code> before init
    scripts+='<script>
  document.querySelectorAll("pre.mermaid").forEach(function(pre) {
    var code = pre.querySelector("code");
    if (code) { pre.textContent = code.textContent; }
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
<script>mermaid.initialize({startOnLoad: true, theme: "dark"});</script>
'
  fi
  if [[ "$body" == *'class="math '* ]]; then
    # Matches both class="math inline" and class="math display"
    scripts+='<script id="MathJax-script" src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
'
  fi

  cat > "$tmphtml" <<HTMLEOF
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${safe_title}</title>
<style>
${CSS}
</style>
</head>
<body>
<div class="markdown-body">
${body}
</div>
${scripts}</body>
</html>
HTMLEOF

  tmpfiles+=("$tmphtml")
  ((++converted))
done

if [[ $converted -eq 0 ]]; then
  echo "Error: no files were converted" >&2
  exit 1
fi

# Open files one at a time to avoid flooding the browser with tabs
for f in "${tmpfiles[@]}"; do
  open "$f"
done

# Disarm the EXIT trap (files are now open), then schedule background cleanup.
# 10 seconds gives the browser time to read the files before they're deleted.
trap - EXIT
(sleep 10 && rm -f "${tmpfiles[@]}") & disown
